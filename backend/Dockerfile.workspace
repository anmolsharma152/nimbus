FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# System-level git defaults so they apply to the unprivileged agent user
RUN git config --system user.name "Nimbus Agent" && \
    git config --system user.email "agent@nimbus.ai" && \
    git config --system --add safe.directory "*"

# Agent commands and git helpers run as this user (UID must match WORKSPACE_USER in app/workspace.py).
# /workspace ownership is copied into each task's fresh volume on first mount.
RUN useradd --uid 10001 --create-home --shell /bin/bash agent && \
    mkdir -p /workspace && chown agent:agent /workspace

USER agent
WORKDIR /workspace
CMD ["tail", "-f", "/dev/null"]
