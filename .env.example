# Nimbus Environment Variables Configuration Template

# Database Connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nimbus_user:nimbus_password@localhost:5432/nimbus_db

# Background Job Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Tier 1 (Primary): Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Tier 2 (Secondary Fallback): Groq Clean Models (openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Tier 3 (Tertiary Fallback): OpenRouter Free Tier (google/gemma-4-31b-it:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# GitHub Integration (Optional: for private repo cloning and Draft PR creation)
GITHUB_TOKEN=your_github_personal_access_token_here

# Control Plane & Limits
MAX_AGENT_ITERATIONS=20
API_INTERNAL_URL=http://localhost:8000
DB_ECHO=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
