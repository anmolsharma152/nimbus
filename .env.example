# Nimbus Environment Variables Configuration Template

# Database Connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nimbus_user:nimbus_password@localhost:5432/nimbus_db

# Background Job Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Tier 1 (Primary): Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Tier 2 (Secondary Fallback): Groq Clean Models (openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Tier 3 (Tertiary Fallback): OpenRouter Free Tier (google/gemma-4-31b-it:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Repo tasks use the signed-in user's GitHub OAuth token or saved PAT; there is no server-wide token.

# Control Plane & Limits
MAX_AGENT_ITERATIONS=20
TASK_TIMEOUT_SECONDS=1800
WORKSPACE_IMAGE=nimbus-workspace:latest
API_INTERNAL_URL=http://localhost:8000
DB_ECHO=false
LOG_LEVEL=INFO
# LOG_FORMAT: "json" for log platforms (Render), "text" for local reading
LOG_FORMAT=text
# Where GitHub returns after sign-in. In production the frontend proxies /api, so set this to the
# frontend URL (and register <that URL>/api/auth/github/callback in the GitHub OAuth app). Empty = API origin.
OAUTH_REDIRECT_BASE_URL=
# COOKIE_SECURE defaults to true when FRONTEND_URL is https

# Frontend Configuration
# The frontend proxies /api/* to API_PROXY_URL (next.config.ts) so the session cookie is first-party.
API_PROXY_URL=http://localhost:8000
# WebSockets connect to the backend directly, authenticated by a short-lived stream ticket.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
